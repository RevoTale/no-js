package hero

import "fmt"

css card() {
	border: 1px solid #123;
	padding: 12px;
}

css Progress(percent int) {
	width: { fmt.Sprintf("%d%%", percent) };
	background-color: #123;
	color: white;
}

templ Hero(body string, percent int) {
	<section class={ card() } data-card="hero">
		<p>{ body }</p>
		<div class="meter">
			<div class={ Progress(percent) } data-progress={ fmt.Sprintf("%d", percent) }>
				Progress { fmt.Sprintf("%d%%", percent) }
			</div>
		</div>
	</section>
}
