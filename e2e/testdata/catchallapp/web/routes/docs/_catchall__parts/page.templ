package parts

import "example.com/no-js-e2e/catchallapp/web/view"

css docsPage() {
	background: #eef5ff;
	padding: 12px;
}

templ Page(model view.CatchAllPageView) {
	<main id="docs-catchall" class={ docsPage() }>
		<p data-joined>{ model.Joined }</p>
		<p data-depth>{ model.Depth }</p>
	</main>
}
