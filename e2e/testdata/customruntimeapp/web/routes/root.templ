package routes

import (
	"example.com/templcssapp/web/view"
	"github.com/RevoTale/no-js/framework/metagen"
)

templ RootLayout(meta metagen.Metadata, locale string, child templ.Component) {
	<html lang={ locale }>
		<head>
			<link id="site-css" rel="stylesheet" href={ runtime.StaticAssetURL("site.css") }>
			@metagen.Head(meta)
		</head>
		<body id="root-layout">
			@child
		</body>
	</html>
}
