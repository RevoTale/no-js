package ops

import (
	"example.com/no-js-e2e/clientassetsslotgroupapp/web/components/insight"
	"example.com/no-js-e2e/clientassetsslotgroupapp/web/view"
)

templ Page(model view.OpsPageView) {
	<article data-route-page="grouped-ops" class={ PageShellClass }>
		<h1>{ model.Heading }</h1>
		@insight.Insight("ops page insight")
	</article>
}
