package routes

import "example.com/no-js-e2e/i18nprefixalwaysapp/web/components"
import "example.com/no-js-e2e/i18nprefixalwaysapp/web/view"

templ Page(model view.HomePageView) {
	<main id="home-page">
		@components.Hero(model.Heading, model.Locale)
		<p id="home-kicker">{ model.Kicker }</p>
		<nav>
			<a id="switch-en" href={ model.SwitchToEnglish }>English</a>
			<a id="switch-de" href={ model.SwitchToGerman }>Deutsch</a>
		</nav>
	</main>
}
