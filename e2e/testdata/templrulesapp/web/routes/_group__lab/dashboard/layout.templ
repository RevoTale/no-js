package dashboard

import "example.com/no-js-e2e/templrulesapp/web/view"

css shell() {
	background: #f4f7fb;
	padding: 18px;
}

templ Layout(model view.RootLayoutView, child templ.Component, inspector templ.Component) {
	<section data-layout="dashboard" class={ shell() }>
		@child
		@inspector
	</section>
}
