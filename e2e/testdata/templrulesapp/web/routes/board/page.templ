package board

import "example.com/no-js-e2e/templrulesapp/web/components"
import "example.com/no-js-e2e/templrulesapp/web/view"

templ Page(view runtime.BoardPageView) {
	<main id="board-page">
		@components.Board(
			components.BoardHeader(view.Title),
			components.BoardBody(view.Body),
		)
	</main>
}
