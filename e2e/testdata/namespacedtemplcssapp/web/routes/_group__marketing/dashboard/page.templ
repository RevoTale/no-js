package dashboard

import "example.com/no-js-e2e/namespacedtemplcssapp/web/components/statchip"
import "example.com/no-js-e2e/namespacedtemplcssapp/web/view"

css dashboardCard() {
	border: 2px solid #17324d;
	padding: 14px;
}

templ Page(model view.RootLayoutView) {
	<main id="marketing-dashboard" class={ dashboardCard() }>
		<h1>Marketing Dashboard</h1>
		@statchip.StatChip("Qualified pipeline", 72)
	</main>
}
