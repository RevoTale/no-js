package analytics

import (
	"example.com/no-js-e2e/namespacedtemplcssapp/web/components"
	"example.com/no-js-e2e/namespacedtemplcssapp/web/view"
)

css analyticsCard() {
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

templ Default(model view.RootLayoutView) {
	<section class={ analyticsCard() } data-slot="analytics">
		<p>Quarterly analytics</p>
		@components.StatChip("Conversions", 72)
	</section>
}
