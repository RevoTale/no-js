package parts

import "example.com/no-js-e2e/optionalcatchallapp/web/view"

css libraryPage() {
	background: #fff7ed;
	padding: 12px;
}

templ Page(model view.OptionalCatchAllPageView) {
	<main id="library-page" class={ libraryPage() }>
		<p data-joined>{ model.Joined }</p>
		<p data-depth>{ model.Depth }</p>
	</main>
}
