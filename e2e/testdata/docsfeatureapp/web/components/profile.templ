package components

import "fmt"

css card() {
	border: 1px solid #224;
	padding: 12px;
}

css eyebrow() {
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

css ProgressBar(percent int) {
	width: { fmt.Sprintf("%d%%", percent) };
	background: #17324d;
	color: white;
}

templ ProfileCard(label string, percent int) {
	<section class={ card() } data-component="profile-card">
		<p class={ eyebrow() }>{ label }</p>
		<div class={ ProgressBar(percent) } data-progress={ fmt.Sprintf("%d", percent) }>
			{ fmt.Sprintf("%d%%", percent) }
		</div>
	</section>
}
