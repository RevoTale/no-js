package analytics

import (
	"example.com/no-js-e2e/docsfeatureapp/web/components"
	"example.com/no-js-e2e/docsfeatureapp/web/view"
)

css analyticsShell() {
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

templ Default(view runtime.RootLayoutView) {
	<aside class={ analyticsShell() } data-slot="analytics">
		<p>Quarterly analytics</p>
		@components.ProfileCard("Conversions", 72)
	</aside>
}
