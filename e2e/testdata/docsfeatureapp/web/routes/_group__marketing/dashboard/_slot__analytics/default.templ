package analytics

import (
	"example.com/no-js-e2e/docsfeatureapp/web/components/profile"
	"example.com/no-js-e2e/docsfeatureapp/web/view"
)

css analyticsShell() {
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

templ Default(model view.RootLayoutView) {
	<aside class={ analyticsShell() } data-slot="analytics">
		<p>Quarterly analytics</p>
		@profile.ProfileCard("Conversions", 72)
	</aside>
}
