package discover

import "example.com/no-js-e2e/groupednamespaceapp/web/view"

css shopShell() {
	border: 2px dashed #9a3412;
	padding: 18px;
	background: #fff7ed;
}

templ Layout(model view.RootLayoutView, child templ.Component) {
	<section data-layout="shop-discover" class={ shopShell() }>
		<header>Shop Discover</header>
		@child
	</section>
}
