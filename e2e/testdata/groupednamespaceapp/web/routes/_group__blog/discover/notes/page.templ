package notes

import "example.com/no-js-e2e/groupednamespaceapp/web/components/discovercard"
import "example.com/no-js-e2e/groupednamespaceapp/web/view"

css notesPage() {
	background: #eef5ff;
	padding: 10px;
}

templ Page(model view.RootLayoutView) {
	<main id="discover-notes" class={ notesPage() }>
		@discovercard.DiscoverCard("Blog", "Notes", 64)
	</main>
}
