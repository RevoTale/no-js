package guides

import "example.com/templcssapp/web/components"
import "example.com/templcssapp/web/view"

css guidesPage() {
	border: 1px dashed #17594a;
	padding: 10px;
}

templ Page(view runtime.RootLayoutView) {
	<main id="discover-guides" class={ guidesPage() }>
		@components.DiscoverCard("Editorial", "Guides", 64)
	</main>
}
