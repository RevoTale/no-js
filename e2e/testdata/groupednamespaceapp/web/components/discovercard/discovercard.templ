package discovercard

import "fmt"

css card() {
	border: 1px solid #224;
	padding: 12px;
}

css eyebrow() {
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

css ProgressBar(percent int) {
	width: { fmt.Sprintf("%d%%", percent) };
	background: #17324d;
	color: white;
	padding: 4px;
}

templ DiscoverCard(label string, title string, percent int) {
	<article data-component="discover-card" class={ card() }>
		<p class={ eyebrow() }>{ label }</p>
		<h2>{ title }</h2>
		<div data-progress={ fmt.Sprintf("%d", percent) } class={ ProgressBar(percent) }>
			{ fmt.Sprintf("%d%%", percent) }
		</div>
	</article>
}
